        <div id="themeDialog" title="{{ translate('Popup style') }}">
            <div class="gg-pth">

                <div class="gg-pth-head">
                    <div class="gg-pth-head-copy">
                        <h2>{{ translate('Choose how a photo opens') }}</h2>
                        <p>{{ translate('This is what visitors see after clicking an image in your gallery.') }}</p>
                    </div>
                    {% if not isProBuild %}
                        <a class="gg-pth-head-cta" href="{{ themeProUrl }}" target="_blank" rel="noopener">
                            <i class="fa fa-star"></i>
                            {{ translate('Unlock all styles') }}
                        </a>
                    {% endif %}
                </div>

                <div class="gg-pth-grid">
                    {% for value, theme in popupThemes %}
                        {% set locked = (not isProBuild) and value != freePopupTheme %}
                        {% set active = (value == effectiveTheme) and not locked %}
                        {% set cardClass = 'gg-pth-card' ~ (locked ? ' is-locked' : '') ~ (active ? ' is-active' : '') %}

                        {% if locked %}
                            <a class="{{ cardClass }}" href="{{ themeProUrl }}" target="_blank" rel="noopener"
                               data-val="{{ value }}" data-name="{{ theme.name }}" data-locked="1"
                               title="{{ translate('Available in PRO') }}">
                        {% else %}
                            <button type="button" class="{{ cardClass }}"
                                    data-val="{{ value }}" data-name="{{ theme.name }}" data-locked="0">
                        {% endif %}

                            <span class="gg-pth-shot">
                                <img src="{{ environment.getModule('colorbox').getThemeScreenshotUrl(value) }}"
                                     alt="{{ theme.name }}" loading="lazy">
                                <span class="gg-pth-veil">
                                    <span class="gg-pth-veil-txt">
                                        {{ locked ? translate('Unlock in PRO') : translate('Use this style') }}
                                    </span>
                                </span>
                                <span class="gg-pth-check" aria-hidden="true"><i class="fa fa-check"></i></span>
                            </span>

                            <span class="gg-pth-foot">
                                <span class="gg-pth-name">{{ theme.name }}</span>
                                {% if locked %}
                                    <span class="gg-pth-tag is-pro">{{ translate('PRO') }}</span>
                                {% elseif not isProBuild %}
                                    <span class="gg-pth-tag is-free">{{ translate('FREE') }}</span>
                                {% endif %}
                            </span>
                            {% if theme.note %}
                                <span class="gg-pth-note">{{ theme.note }}</span>
                            {% endif %}

                        {% if locked %}</a>{% else %}</button>{% endif %}
                    {% endfor %}
                </div>

                {% set popupPlacementType = (settings.popup.placementType == null ? 0 : settings.popup.placementType) %}
                {% set fitOptions = {
                    '0': { 'id': 'popupPlacementTypeFts', 'label': translate('Fit to screen') },
                    '1': { 'id': 'popupPlacementTypeFw',  'label': translate('Fit width') },
                    '2': { 'id': 'popupPlacementTypeSo',  'label': translate('Show original') },
                } %}

                <div class="popupPlacementTypeWrapper gg-pth-fit{{ isProBuild ? '' : ' is-locked' }}">
                    <div class="gg-pth-fit-head">
                        <h4>{{ translate('How the image fits the screen') }}</h4>
                        {% if not isProBuild %}
                            <a class="gg-pth-tag is-pro gg-pth-tag-link" href="{{ themeProUrl }}" target="_blank" rel="noopener">{{ translate('PRO') }}</a>
                        {% endif %}
                    </div>
                    <div class="gg-pth-fit-opts">
                        {% for value, opt in fitOptions %}
                            <span class="gg-pth-fit-opt">
                                {{ form.radio(
                                    'popup[placementType]',
                                    value,
                                    {'id': opt.id, 'class': 'popupPlacementTypeRadio'}
                                        |merge(popupPlacementType == value ? {'checked':'checked'} : {})
                                        |merge(isProBuild ? {} : {'disabled':'disabled'})
                                ) }}
                                {{ form.label(opt.label, opt.id) }}
                            </span>
                        {% endfor %}
                    </div>
                </div>

            </div>
        </div>

        <div id="effectDialog" title="{{ translate('Select overlay effect') }}">
