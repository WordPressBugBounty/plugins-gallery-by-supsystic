            <div data-tab="settings">

            {% block attributes %}
                <table class="form-table" name="attributes" id="gg-anl-attributes">
                    <thead>
                        {{ form.getProPanelRow(translate('Custom Attributes'), 'utm_source=plugin&utm_campaign=gallery', null, tooltips['customAttributes']|default(null)) }}
                    </thead>
                </table>

            {% endblock %}

			<div class="exit-info">
				{% block exifCaptionSettings %}
				{{ form.getProPanel(translate('Show EXIF data'), 'utm_source=plugin&utm_medium=exif-data&utm_campaign=gallery', 'ggExifDataTable', tooltips['showExifDataPro']|default(null)) }}

				{% endblock %}
			</div>

			{% block additionalCaptionSettings %}
				<table class="form-table" name="captionAdditSett" id="gg-anl-caption-add-sett">
					<thead>
						{{ form.getProPanelRow(translate('Thumbnail Effects'), 'utm_source=plugin&utm_medium=additinalCaptionSettings&utm_campaign=gallery', null, tooltips['additionalCaptionSettingInPro']|default(null)) }}
					</thead>
				</table>
			{% endblock %}
			{{ form.hidden(
				'adminPage[slimScrollStartPos]',
				settings.adminPage.slimScrollStartPos | default(0),
				{'id': 'slimScrollStartPos'}
			) }}

        </div>

        {# =================================================================
           Delivery & optimization. Both used to be a separate top-level admin
           page driving every gallery at once; they are per-gallery options
           now. Storage is unchanged (gg_cdn / gg_image_optimize keyed by
           gallery_id), so a gallery optimized or transferred under the old
           page shows its existing stats here straight away. Credentials stay
           global, in Advanced Settings.
           ================================================================= #}
        <div data-tab="settings">

            {% set optProUtm = 'utm_source=plugin&utm_medium=optimization&utm_campaign=gallery' %}
            {% set ecommerceDeliveryDisabled = hasEcommerceRestrictions|default(false) %}
            {% set ecommerceDeliveryNotice = translate('E-commerce restrictions are active for this gallery, so CDN and image optimization are disabled. E-commerce uses protected previews and gated downloads to avoid leaking restricted originals.') %}
            {% set optShots %}
                {% for shot in ['01'] %}
                    <img src="{{ SGG_PLUGIN_URL }}/src/GridGallery/Overview/assets/img/optimization/{{ shot }}.png"
                         style="max-width:99%;display:block;border-radius:4px;border:1px solid #eaeaea;margin-bottom:8px;" />
                {% endfor %}
            {% endset %}
            {% set imageOptimizationUpsellImage %}
                <img src="{{ SGG_PLUGIN_URL }}/src/GridGallery/Overview/assets/img/optimization/image_optimization.png"
                     style="max-width:99%;display:block;border-radius:4px;border:1px solid #eaeaea;margin-bottom:8px;" />
            {% endset %}

            {% block cdn %}
                {% set cdnEnabled = ecommerceDeliveryDisabled ? false : settings.cdn.enabled|default('false') == 'true' %}
                <table class="form-table" name="cdn" id="gg-anl-cdn">
                    {% if environment.isPro() %}
                        <thead>
                            {{ form.row(translate('CDN'),
                                form.radio('cdn[enabled]', 'true', {'id':'cdn-enable'}|merge(cdnEnabled ? {'checked':'checked'} : {})|merge(ecommerceDeliveryDisabled ? {'disabled':'disabled'} : {})) ~
                                f.label(translate('Enable'), 'cdn-enable') ~
                                form.radio('cdn[enabled]', 'false', {'id':'cdn-disable'}|merge(cdnEnabled ? {} : {'checked':'checked'})|merge(ecommerceDeliveryDisabled ? {'disabled':'disabled'} : {})) ~
                                f.label(translate('Disable'), 'cdn-disable'),
                                'sgg-t-cdn-enable', true, 'useCdnRow') }}
                            {% if ecommerceDeliveryDisabled %}
                                <tr>
                                    <th scope="row"></th>
                                    <td><p class="gg-svc-hint gg-ecommerce-delivery-warning">{{ ecommerceDeliveryNotice }}</p></td>
                                </tr>
                            {% endif %}
                        </thead>
                        <tbody{{ cdnEnabled ? '' : ' style="display: none;"' }}>
                            {{ form.row(translate('Auto-transfer on change'),
                                form.checkbox('cdn[auto]', '1', settings.cdn.auto|default('0') == '1' ? {'checked':'checked'} : {}),
                                'sgg-t-cdn-auto') }}

                            <tr>
                                <th scope="row">
                                    <label>{{ translate('This gallery on CDN') }}</label>
                                </th>
                                <td>
                                    {% if cdnStats %}
                                        <div class="gg-svc-stats">
                                            <span><b>{{ cdnStats.size_mb }}</b> {{ translate('Mb') }}</span>
                                            <span>{{ translate('via') }} <b>{{ cdnStats.service_name|default('CDN') }}</b></span>
                                            <span>{{ translate('last transfer') }} <b>{{ cdnStats.last_date|default('—') }}</b></span>
                                        </div>
                                    {% else %}
                                        <div class="gg-svc-stats is-empty">{{ translate('Not transferred yet.') }}</div>
                                    {% endif %}

                                    {% if servicesReady.keycdn|default(false) %}
                                        <button type="button" class="button button-primary gg-svc-run" id="gg-cdn-run"
                                                data-gallery-id="{{ gallery.id }}">
                                            <i class="fa fa-cloud-upload"></i>
                                            {{ translate('Transfer to CDN now') }}
                                        </button>
                                    {% else %}
                                        <p class="gg-svc-hint">
                                            {{ translate('Add your CDN credentials in') }}
                                            <a href="{{ environment.generateUrl('settings') }}">{{ translate('Advanced Settings') }}</a>
                                            {{ translate('to enable transfers.') }}
                                        </p>
                                    {% endif %}
                                    <span class="gg-svc-progress" id="gg-cdn-progress"></span>
                                </td>
                            </tr>
                        </tbody>
                    {% else %}
                        {% set cdnProDescription %}
                            <p>{{ translate('Push the images in this gallery to a Content Delivery Network so they are served from a location close to each visitor. Transfers can run automatically whenever you add or replace images.') }}</p>
                            {{ optShots }}
                        {% endset %}
                        <thead>
                            {{ form.getProPanelRow(translate('CDN'), optProUtm, 'useCdnRow', cdnProDescription) }}
                        </thead>
                    {% endif %}
                </table>
            {% endblock %}

            {% block optimization %}
                {% set optEnabled = ecommerceDeliveryDisabled ? false : settings.optimization.enabled|default('false') == 'true' %}
                {% set optEngine = settings.optimization.engine|default('tinypng') %}
                {% set optFrontendFormat = settings.optimization.frontend_format|default(settings.optimization.serve_avif|default('0') == '1' ? 'avif' : (settings.optimization.serve_webp|default('0') == '1' ? 'webp' : 'original')) %}
                <table class="form-table" name="optimization" id="gg-anl-optimization">
                    {% if environment.isPro() %}
                        <thead>
                            {{ form.row(translate('Image Optimization'),
                                form.radio('optimization[enabled]', 'true', {'id':'opt-enable'}|merge(optEnabled ? {'checked':'checked'} : {})|merge(ecommerceDeliveryDisabled ? {'disabled':'disabled'} : {})) ~
                                f.label(translate('Enable'), 'opt-enable') ~
                                form.radio('optimization[enabled]', 'false', {'id':'opt-disable'}|merge(optEnabled ? {} : {'checked':'checked'})|merge(ecommerceDeliveryDisabled ? {'disabled':'disabled'} : {})) ~
                                f.label(translate('Disable'), 'opt-disable'),
                                'sgg-t-optimize-enable', true, 'useOptimizationRow') }}
                            {% if ecommerceDeliveryDisabled %}
                                <tr>
                                    <th scope="row"></th>
                                    <td><p class="gg-svc-hint gg-ecommerce-delivery-warning">{{ ecommerceDeliveryNotice }}</p></td>
                                </tr>
                            {% endif %}
                        </thead>
                        <tbody{{ optEnabled ? '' : ' style="display: none;"' }}>
                            {{ form.row(translate('Compress with'),
                                form.select('optimization[engine]', {
                                    'tinypng': translate('TinyPNG service'),
                                    'server': translate('This server (GD / Imagick)'),
                                }, optEngine, {'style': 'width: auto', 'id': 'gg-opt-engine'}),
                                'sgg-t-optimize-engine') }}

                            {# Server-engine only: TinyPNG resizes and re-encodes on its
                               own side, so these would be silently ignored there. #}
                            <tr class="gg-opt-server-only">
                                <th scope="row">
                                    <label for="gg-opt-max-width">{{ translate('Max width') }}</label>
                                    {{ form.show_tooltip('sgg-t-optimize-max-size') }}
                                </th>
                                <td>
                                    {{ form.input('number', 'optimization[max_width]', settings.optimization.max_width|default(''), {'id': 'gg-opt-max-width', 'min': '0', 'style': {'width': '110px'}, 'placeholder': translate('auto')}) }}
                                    {{ form.span('', 'pixels') }}
                                </td>
                            </tr>
                            <tr class="gg-opt-server-only">
                                <th scope="row">
                                    <label for="gg-opt-max-height">{{ translate('Max height') }}</label>
                                </th>
                                <td>
                                    {{ form.input('number', 'optimization[max_height]', settings.optimization.max_height|default(''), {'id': 'gg-opt-max-height', 'min': '0', 'style': {'width': '110px'}, 'placeholder': translate('auto')}) }}
                                    {{ form.span('', 'pixels') }}
                                    <p class="gg-svc-hint">{{ translate('Leave either field empty to keep the original proportions.') }}</p>
                                </td>
                            </tr>
                            <tr class="gg-opt-server-only">
                                <th scope="row">
                                    <label for="gg-opt-quality">{{ translate('Compression level') }}</label>
                                    {{ form.show_tooltip('sgg-t-optimize-quality') }}
                                </th>
                                <td>
                                    {{ form.input('number', 'optimization[quality]', settings.optimization.quality|default(100), {'id': 'gg-opt-quality', 'min': '1', 'max': '100', 'style': {'width': '110px'}}) }}
                                    {{ form.span('', '%') }}
                                    <p class="gg-svc-hint">{{ translate('100 keeps the image untouched. 85-95 usually looks identical at a fraction of the weight.') }}</p>
                                </td>
                            </tr>
                            <tr class="gg-opt-server-only">
                                <th scope="row">
                                    <label>{{ translate('Replace original image') }}</label>
                                    {{ form.show_tooltip('sgg-t-optimize-replace') }}
                                </th>
                                <td>
                                    {{ form.checkbox('optimization[replace_original]', '1', settings.optimization.replace_original|default('0') == '1' ? {'checked':'checked'} : {}) }}
                                </td>
                            </tr>
                            <tr>
                                <th scope="row">
                                    <label for="gg-opt-frontend-format">{{ translate('Show on frontend as') }}</label>
                                    {{ form.show_tooltip('sgg-t-optimize-serve') }}
                                </th>
                                <td>
                                    {{ form.select('optimization[frontend_format]', {
                                        'original': translate('Original format'),
                                        'webp': 'WebP',
                                        'avif': 'AVIF',
                                    }, optFrontendFormat, {'style': 'width: auto', 'id': 'gg-opt-frontend-format'}) }}
                                    <p class="gg-svc-hint">{{ translate('This controls the format visitors receive for gallery thumbnails and popup images. If the browser cannot display the selected format, the original image is used.') }}</p>
                                </td>
                            </tr>

                            <tr>
                                <th scope="row">
                                    <label>{{ translate('This gallery') }}</label>
                                </th>
                                <td>
                                    {% if optimizeStats %}
                                        <div class="gg-svc-stats">
                                            <span><b>{{ optimizeStats.percent }}%</b> {{ translate('smaller') }}</span>
                                            <span>{{ optimizeStats.optimized_mb }} / {{ optimizeStats.size_mb }} {{ translate('Mb') }}</span>
                                            <span>{{ translate('via') }} <b>{{ optimizeStats.service_name|default('—') }}</b></span>
                                            <span>{{ translate('last run') }} <b>{{ optimizeStats.last_date|default('—') }}</b></span>
                                        </div>
                                    {% else %}
                                        <div class="gg-svc-stats is-empty">{{ translate('Not optimized yet.') }}</div>
                                    {% endif %}

                                    <button type="button" class="button button-primary gg-svc-run" id="gg-opt-run"
                                            data-gallery-id="{{ gallery.id }}">
                                        <i class="fa fa-compress"></i>
                                        {{ translate('Optimize now') }}
                                    </button>
                                    <span class="gg-svc-progress" id="gg-opt-progress"></span>

                                    {% if not servicesReady.tinypng|default(false) %}
                                        <p class="gg-svc-hint gg-opt-tinypng-only">
                                            {{ translate('TinyPNG needs an API key in') }}
                                            <a href="{{ environment.generateUrl('settings') }}">{{ translate('Advanced Settings') }}</a>.
                                        </p>
                                    {% endif %}
                                    {% if not servicesReady.server|default(false) %}
                                        <p class="gg-svc-hint gg-opt-server-only">
                                            {{ translate('This server has neither GD nor Imagick available.') }}
                                        </p>
                                    {% endif %}
                                </td>
                            </tr>
                        </tbody>
                    {% else %}
                        {% set optProDescription %}
                            <p>{{ translate('Compress every image in this gallery - through TinyPNG or directly on your own server - resize oversized photos, and generate modern WebP and AVIF versions to serve on the frontend.') }}</p>
                            {{ imageOptimizationUpsellImage }}
                        {% endset %}
                        <thead>
                            {{ form.getProPanelRow(translate('Image Optimization'), optProUtm, 'useOptimizationRow', optProDescription) }}
                        </thead>
                    {% endif %}
                </table>
            {% endblock %}

        </div>


        {% block form %}
        {% endblock %}

        {{ form.close() }}

        <div id="saveDialog" title="{{ translate('Save settings as preset') }}">
            <div>
                <label for="presetTitle">
                    {{ translate('Preset title:') }}
                </label>
            </div>
            <div>
                <input id="presetTitle" type="text" name="title" style="width:100%;" value="{{ preset.title }}"/>
                <input id="settingsId" type="hidden" name="settings_id" value="{{ id }}"/>
            </div>
        </div>

        <div id="deletePreset" title="{{ translate('Delete preset') }}">
            <p>
                {{ translate('Are you really want to delete preset "%s"?')|format(preset.title) }}
            </p>
            <input type="hidden" id="presetId" value="{{ preset.id }}">
        </div>

        <div id="loadPreset" title="{{ translate('Load settings from presets') }}">
            <div>
                <label for="presetList">{{ translate('Select preset:') }}</label>
            </div>
            <div>
                <select id="presetList" name="presetList" style="width:100%"></select>
            </div>
            <div id="presetListError">
                <p id="presetLoadingFailed" style="display:none">
                    {{ translate('Failed to load the presets.') }}
                </p>

                <p id="presetEmpty" style="display:none">
                    {{ translate('Currently you have no presets.') }}
                </p>
            </div>
        </div>

        {# ---------------------------------------------------------------
           Popup / lightbox style picker.

           The base Colorbox theme is FREE; every other theme and the
           image-fit modes are PRO. `freePopupTheme` must stay in sync with
           GridGallery_Galleries_Module::FREE_POPUP_THEME, which is what
           actually enforces this on the frontend - if they drift, this
           dialog starts advertising a theme the gallery won't render.
        --------------------------------------------------------------- #}
        {% set freePopupTheme = 'theme_1' %}
        {% set isProBuild = environment.isPro() %}
        {% set themeProUrl = getProUrl('?utm_source=plugin&utm_medium=popup_theme&utm_campaign=gallery') %}

        {# Highlight the theme that ACTUALLY renders, not the one in the DB. A
           gallery created before the popup went Free (or under a lapsed
           licence) can still have a locked theme stored - Free renders
           freePopupTheme for it regardless, so marking the locked card as
           "selected" would be another settings-page-lies bug. The stored value
           itself is left alone so it comes back intact if they go PRO. #}
        {% set effectiveTheme = isProBuild ? settings.box.theme|default(freePopupTheme) : freePopupTheme %}

        {# Notes describe what each style actually does on screen - taken from
           the themes' own CSS (backdrop colour, caption placement, arrow style,
           counter visibility) and from the prettyPhoto/photobox engines behind
           theme_6 / theme_1_pro. Keep them factual: they are the only thing a
           user has to go on before picking. #}
        {% set popupThemes = {
            'theme_1': { 'name': translate('Theme 1'), 'note': translate('Dimmed backdrop, caption under the photo') },
            'theme_2': { 'name': translate('Theme 2'), 'note': translate('Light backdrop, small icon controls') },
            'theme_3': { 'name': translate('Theme 3'), 'note': translate('Dark backdrop, arrows at the sides') },
            'theme_4': { 'name': translate('Theme 4'), 'note': translate('Light backdrop, wide arrow zones') },
            'theme_5': { 'name': translate('Theme 5'), 'note': translate('Dark backdrop with slideshow controls') },
            'theme_6': { 'name': translate('Theme 6'), 'note': translate('Thumbnail strip, rotate and link buttons') },
            'theme_7': { 'name': translate('Theme 7'), 'note': translate('Solid black, no counter, fits Linked images') },
