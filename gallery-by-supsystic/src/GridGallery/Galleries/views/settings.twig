{% extends 'grid-gallery.twig' %}
{% macro label(label, for) %}
    <label for="{{ for }}">{{ label }}</label>
{% endmacro %}
 {% set borderTypes = {
     'solid': 'Solid',
     'dotted': 'Dotted',
     'dashed': 'Dashed',
     'double': 'Double',
     'groove': 'Groove',
     'ridge': 'Ridge',
     'inset': 'Inset',
     'outset': 'Outset',
     'none': 'None'
 } %}

{% set galleryCreatedDate = gallery.created is not empty ? gallery.created : (gallery.photos is not empty ? gallery.photos[0].timestamp : null) %}

{% set galleryTypeLabels = {
    '0': 'Fixed',
    '1': 'Vertical',
    '2': 'Horizontal',
    '3': 'Fixed Columns',
    '4': 'Mosaic',
} %}
{% set galleryTypeLabel = galleryTypeLabels[settings.area.grid|default('0')]|default(galleryTypeLabels['0']) %}

{% set galleryCategoriesList = [] %}
{% for photo in gallery.photos %}
    {% for tag in photo.tags|default([]) %}
        {% if tag is not empty and tag not in galleryCategoriesList %}
            {% set galleryCategoriesList = galleryCategoriesList|merge([tag]) %}
        {% endif %}
    {% endfor %}
{% endfor %}

{% set popupEnabled = settings.box.enabled|default('true') == 'true' %}
{# Icons/Captions below are the older, separate system Caption Builder
   replaces (see the "caption-type" toggle in the Captions section) - only
   one of the two is ever actually live at once, so once Caption Builder
   takes over, showing these as still "on" would be misleading even if
   their own stored value is still 'true' from before the switch. #}
{% set galleryFeatureStatuses = [
    { 'label': translate('Popup'), 'enabled': popupEnabled, 'alwaysAvailable': true, 'anchor': 'gg-anl-popup' },
    { 'label': translate('Gallery Loader'), 'enabled': settings.preload.enabled|default('true') == 'true', 'alwaysAvailable': true, 'anchor': 'gg-anl-preloader' },
    { 'label': translate('Horizontal Scroll'), 'enabled': settings.horizontalScroll.enabled|default('false') == 'true', 'alwaysAvailable': true, 'anchor': 'gg-anl-horiz-scroll' },
    { 'label': translate('Slideshow'), 'enabled': popupEnabled and settings.box.slideshow|default('false') == 'true', 'alwaysAvailable': true, 'proLabel': true, 'anchor': 'gg-anl-popup' },
    { 'label': translate('Categories'), 'enabled': settings.categories.enabled|default('false') == 'true', 'anchor': 'useCats', 'presetSeeded': true },
    { 'label': translate('Posts'), 'enabled': settings.posts.enable|default(0) == 1, 'anchor': 'sgg-posts-layout-enable', 'presetSeeded': true },
    { 'label': translate('Pagination'), 'enabled': settings.pagination.enabled|default('false') == 'true', 'anchor': 'usePages', 'presetSeeded': true },
    { 'label': translate('Load More'), 'enabled': settings.showMore.enabled|default('false') == 'true', 'anchor': 'gg-anl-load-more' },
    { 'label': translate('Watermark'), 'enabled': settings.watermark.enabled|default(false), 'anchor': 'showWatermRow' },
    { 'label': translate('Social Sharing'), 'enabled': settings.socialSharing.enabled|default(false), 'anchor': 'social-sharing' },
    { 'label': translate('Lazy Load'), 'enabled': settings.lazyload.enabled|default('0') == '1', 'anchor': 'sggLazyLoadEnableRow' },
    { 'label': translate('Border'), 'enabled': settings.thumbnail.border.type|default('none') != 'none', 'alwaysAvailable': true, 'anchor': 'gg-anl-border-type' },
    { 'label': translate('Shadow'), 'enabled': settings.use_shadow|default('0') == '1', 'alwaysAvailable': true, 'anchor': 'useShadowRow' },
    { 'label': translate('Caption Builder'), 'enabled': settings.captionBuilder.enabled|default(0) == 1, 'anchor': 'useCaptionBuilder' },
    { 'label': translate('Icons'), 'enabled': settings.icons.enabled|default('false') == 'true' and settings.captionBuilder.enabled|default(0) != 1, 'anchor': 'photo-icon', 'presetSeeded': true },
    { 'label': translate('Captions'), 'enabled': settings.thumbnail.overlay.enabled|default('true') == 'true' and settings.captionBuilder.enabled|default(0) != 1, 'anchor': 'useCaptions', 'presetSeeded': true },
    { 'label': translate('EXIF data'), 'enabled': settings.exif.enabled|default(0) == 1, 'anchor': 'ggExifDataTable' },
    { 'label': translate('Custom Attributes'), 'enabled': settings.attributes.enabled|default('false') == 'true', 'anchor': 'gg-anl-attributes' },
    { 'label': translate('CDN'), 'enabled': settings.cdn.enabled|default('false') == 'true', 'anchor': 'useCdnRow' },
    { 'label': translate('Optimization'), 'enabled': settings.optimization.enabled|default('false') == 'true', 'anchor': 'useOptimizationRow' },
] %}

{# license.isActive() only exists on the Pro build's license module, and
   getModule() returns null (not an error) when it isn't registered at all
   (Free-only install) - guard the chained call rather than assuming it's
   present, "and" short-circuits so licenseModule.isActive() is never
   reached when licenseModule is null. #}
{% set licenseModule = environment.getModule('license') %}
{% set licenseActive = environment.isPro() and licenseModule and licenseModule.isActive() %}

{# Used to warn before a settings Save while unlicensed: saveSettingsAction
   fully replaces the settings blob from just the submitted fields, and
   disabled Pro fields aren't submitted by the browser at all - saving here
   would silently wipe any Pro option this gallery already has configured.
   Reuses galleryFeatureStatuses' own enabled/anchor data rather than a
   second hand-maintained list of Pro-only keys.

   presetSeeded features (Captions, Categories, Icons, Pagination, Posts)
   are skipped here even though they're Pro-gated in the form below: every
   one of the 9 built-in gallery-creation templates (Galleries configs/
   presets.php, applied to every new gallery) bakes in a fully-populated
   sub-array for these, and at least one shipped preset has each of them
   "enabled" - they were free-available back when those presets were
   authored. A brand new, never-licensed gallery can inherit "enabled" for
   any of these purely from its creation preset, so their stored value
   can't be trusted to mean a Pro session configured it - mirrors
   GridGallery_Galleries_Controller::gallerySettingsHaveProConfigured(). #}
{% set hasProConfiguredSettings = false %}
{% for feature in galleryFeatureStatuses %}
    {% if feature.alwaysAvailable is not defined and feature.presetSeeded is not defined and feature.enabled %}
        {% set hasProConfiguredSettings = true %}
    {% endif %}
{% endfor %}

{% block header %}
    {% import '@core/form.twig' as form %}
    <nav id="supsystic-breadcrumbs" class="supsystic-breadcrumbs">
        <a href="{{ environment.generateUrl('galleries') }}">{{ translate('Galleries') }}</a>
        <i class="fa fa-angle-right"></i>
        <a href="{{ environment.generateUrl('galleries', 'view', { 'gallery_id': gallery.id }) }}">{{ gallery.title }}</a>
    </nav>

    <div class="gg-detailed-info">
        <div class="gg-detailed-info-preview">
            {% if gallery.photos is not empty %}
                <img
                    {% if gallery.photos[0].attachment.isRemoteImage is defined and gallery.photos[0].attachment.isRemoteImage == 1 %}
                    src="{{ gallery.photos[0].attachment.thumbUrl }}"
                    {% else %}
                        src="{{ get_attachment(gallery.photos[0].attachment.id, width, height, crop, cropQuality) }}"
                    {% endif %}
                    alt="{{ gallery.title }}"
                />
            {% else %}
                <div class="gg-no-images-placeholder">
                    {{ translate("There're no images in the gallery.") }}<br>
                </div>
            {% endif %}
        </div>
        <div class="gg-detailed-info-text">
            <div class="gg-detailed-info-heading">
                <section id="single-gallery-toolbar" class="gg-header-toolbar">
                    <ul class="supsystic-bar-controls">
                        <li title="{{ translate('Upload new images') }}">
                            <button class="button button-primary gallery import-to-gallery" data-gallery-id="{{ gallery.id }}">
                                <i class="fa fa-fw fa-camera"></i>
                                {{ translate('Add Images') }}
                            </button>
                        </li>

                        <li>
                            <a class="button"
                               href="{{ environment.generateUrl('galleries', 'view', { 'gallery_id': gallery.id }) }}">
                                <i class="fa fa-list fa-fw"></i>
                                {{ translate('Images list') }}
                            </a>
                        </li>

                        <li>
                            <a class="button button-primary" id="btnPreviewWindow" target="_blank"
                               href="{{ environment.generateUrl('galleries', 'preview', { 'gallery_id': gallery.id }) }}">
                                <i class="fa fa-fw fa-eye"></i>
                                {{ translate('Preview') }}
                            </a>
                        </li>

                        <li>
                            <button class="button button-primary" id="btnSave">
                                <i class="fa fa-fw fa-check"></i>
                                {{ translate('Save') }}
                            </button>
                        </li>
                    </ul>
                </section>
                <div class="gg-code-switcher">
                    <a class="button" id="openSettingsImportDialog" href=""><i class="fa fa-copy"></i> {{ translate('Import settings') }}</a>
                    <a class="button" id="ggCreateClone" href="#" target="_blank" data-url="{{ environment.generateUrl('galleries', 'settings', {'_wpnonce': _wpnonce}) }}">
                        <i class="fa fa-clone"></i>
                        {{ translate('Clone') }}
                    </a>
                    <select id="ggCodeTypeSelect">
                        <option value="shortcode">{{ translate('Shortcode') }}</option>
                        <option value="php">{{ translate('PHP Code') }}</option>
                    </select>
                    <input type="text" id="ggCodeValueShortcode" class="gallery-shortcode gg-code-value" value="[{{ environment.config.get('shortcode_name') }} id={{ gallery.id }}]" onclick="this.select();" size="34" style="font-size: 12px;" readonly>
                    <input type="text" id="ggCodeValuePhp" class="gallery-shortcode gg-code-value" value="{{ '<?php echo do_shortcode(\'[supsystic-gallery id=' ~ gallery.id ~ ']\') ?>' }}" onclick="this.select();" size="34" style="font-size: 12px; display: none;" readonly>
                    {{ form.show_tooltip('sgg-shortcode') }}
                </div>
            </div>
            <div class="gg-info-stats">
                <div class="gg-info-item">
                    <span class="gg-info-label">{{ translate('Name') }}</span>
                    <span class="gg-info-value">{{ gallery.title }}</span>
                    <i class="fa fa-pencil gg-info-edit-link" data-gg-anchor="gallery-name-row" title="{{ translate('Edit') }}"></i>
                </div>
                <div class="gg-info-item">
                    <span class="gg-info-label">{{ translate('Type') }}</span>
                    <span class="gg-info-value">{{ galleryTypeLabel }}</span>
                    <i class="fa fa-pencil gg-info-edit-link" data-gg-anchor="columns" title="{{ translate('Edit') }}"></i>
                </div>
                <a class="gg-info-item gg-info-item-link" href="{{ environment.generateUrl('galleries', 'view', { 'gallery_id': gallery.id }) }}" title="{{ translate('Images list') }}">
                    <span class="gg-info-label">{{ translate('Photos') }}</span>
                    <span class="gg-info-value">{{ gallery.photos|length }}</span>
                </a>
                <div class="gg-info-item">
                    <span class="gg-info-label">{{ translate('Categories used') }}</span>
                    <span class="gg-info-value">{{ galleryCategoriesList|length }}</span>
                </div>
                <div class="gg-info-item">
                    <span class="gg-info-label">{{ translate('Ecommerce') }}</span>
                    <span class="gg-info-value gg-info-value-inline">
                        {% if galleryEcommerceSummary %}
                            <span class="gg-info-summary-text">{{ galleryEcommerceSummary.name }}</span>
                            <a class="gg-info-open-link" href="{{ galleryEcommerceSummary.edit_url }}" title="{{ translate('Edit Ecommerce item') }}">
                                <i class="fa fa-pencil"></i>
                            </a>
                        {% else %}
                            <i class="fa fa-times gg-info-empty-icon" title="{{ translate('No Ecommerce item') }}"></i>
                        {% endif %}
                    </span>
                </div>
                <div class="gg-info-item">
                    <span class="gg-info-label">{{ translate('Groups') }}</span>
                    <span class="gg-info-value gg-info-value-inline">
                        {% if galleryGroupSummary is defined and galleryGroupSummary is not empty %}
                            {% for group in galleryGroupSummary|slice(0, 2) %}
                                <a class="gg-info-chip-link" href="{{ group.edit_url }}" title="{{ group.name }}">{{ group.name|slice(0, 5) }}</a>
                            {% endfor %}
                        {% else %}
                            <i class="fa fa-times gg-info-empty-icon" title="{{ translate('No groups') }}"></i>
                        {% endif %}
                    </span>
                </div>
                <div class="gg-info-dates">
                    <div class="gg-info-item">
                        <span class="gg-info-label">{{ translate('Created') }}</span>
                        <span class="gg-info-value">{{ galleryCreatedDate is not empty ? galleryCreatedDate|date('d.m.y H:i') : '—' }}</span>
                    </div>
                    <div class="gg-info-item">
                        <span class="gg-info-label">{{ translate('Edited') }}</span>
                        <span class="gg-info-value">{{ gallery.modified is not empty ? gallery.modified|date('d.m.Y H:i') : '—' }}</span>
                    </div>
                </div>
            </div>
            <div class="gg-feature-status-list">
                {% for feature in galleryFeatureStatuses %}
                    {% if environment.isPro() or feature.alwaysAvailable %}
                        <button type="button" class="{{ 'gg-feature-status gg-feature-status-link ' ~ ((feature.proLabel and environment.isPro() == false) ? 'gg-feature-status-pro' : (feature.enabled ? 'gg-feature-status-on' : 'gg-feature-status-off')) }}" title="{{ (feature.proLabel and environment.isPro() == false) ? '' : (feature.enabled ? translate('Enabled') : translate('Disabled')) }}" data-gg-anchor="{{ feature.anchor }}">
                            <span class="gg-feature-dot"></span>
                            <span class="gg-feature-label">{{ feature.label }}</span>
                            {% if feature.proLabel and environment.isPro() == false %}
                                <span class="gg-feature-status-pro-badge">{{ translate('PRO') }}</span>
                            {% endif %}
                        </button>
                    {% else %}
                        <button type="button" class="gg-feature-status gg-feature-status-pro gg-pro-read-more-proxy" title="{{ translate('Only in PRO') }}" data-gg-anchor="{{ feature.anchor }}">
                            <span class="gg-feature-dot"></span>
                            <span class="gg-feature-label">{{ feature.label }}</span>
                            <span class="gg-feature-status-pro-badge">{{ translate('PRO') }}</span>
                        </button>
                    {% endif %}
                {% endfor %}
            </div>
        </div>
    </div>

    <div class="gg-settings-header-row">
        <h2 class="form-tabs">
            <a class="nav-tab change-tab" href="settings">
                <i class="fa fa-cog"></i>
				<span class="nav-tab-item-span">{{ translate('Settings') }}</span>
            </a>

            <a class="nav-tab change-tab" href="posts" id="ggPostsTabLink">
                <i class="fa fa-list-alt"></i>
				<span class="nav-tab-item-span">{{ translate('Posts') }}</span>
            </a>
            {% block tabs %}{% endblock %}
        </h2>
    </div>
{% endblock %}

{% block preview %}
    {% if settings.watermark is defined %}
        {% set settingsWatermark = settings.watermark|merge({'galleryId': gallery.id}) %}
        {{ set_attachment_settings('watermark', settingsWatermark) }}
    {% endif %}
	<input type="hidden" id="ggMsgCloningGallery" value="{{ translate('Cloning gallery...') }}"/>
	<input type="hidden" id="ggMsgServerInternalError" value="{{ translate('Server internal error') }}"/>
	<input type="hidden" id="ggMsgImgOptimizationErrorOcured" value="{{ translate('Gallery image optimization error ocured.') }}"/>
	<input type="hidden" id="ggIoParams" value="{{ ioServiceParams }}"/>
	<input type="hidden" id="ggCdnParams" value="{{ cdnServiceParams }}"/>
	<input type="hidden" id="ggMsgOptimized" value="{{ translate("Optimized") }}"/>
	<input type="hidden" id="ggMsgTransfer" value="{{ translate("Transfered") }}"/>
	<input type="hidden" id="ggMsgOf" value="{{ translate("of") }}"/>
	<input type="hidden" id="ggMsgImages" value="{{ translate("images") }}"/>
	<input type="hidden" id="ggMsgGalleryImageOptimizing" value="{{ translate("Gallery Image optimizing...") }}"/>
	<input type="hidden" id="ggMsgGalleryTransferToCnd" value="{{ translate('Tranfer images to CDN') }}"/>
	<input type="hidden" id="ggMsgProWipeWarningTitle" value="{{ translate('PRO license inactive') }}"/>
	<input type="hidden" id="ggMsgProWipeWarningText" value="{{ translate('Your Photo Gallery Pro license is currently inactive. Saving changes now will remove the Pro options already configured for this gallery (watermark, social sharing, icons, and more). Continue?') }}"/>
	<input type="hidden" id="ggMsgProWipeCancel" value="{{ translate('Cancel') }}"/>
	<input type="hidden" id="ggMsgProWipeConfirm" value="{{ translate('Save anyway') }}"/>
	<input type="hidden" id="ggMsgProWipeBlocked" value="{{ translate('Settings were not saved: your Pro license is inactive and this gallery already has Pro options configured. Confirm in the dialog if you want to overwrite them, or reactivate your license first.') }}"/>

	<div id="ggCloneModalWndId" style="display: none;">
		<label for="ggCloneTypeSelector">{{ translate('Select clone type:') }}</label>
		{{ form.select(
			'CloneTypeSelector', {
				'0': translate('Select clone type'),
				'1': translate('Clone with images'),
				'2': translate('Clone without images'),
			},
			0,
			{ 'style': 'width: auto;', 'id': 'ggCloneTypeSelector' })
		}}
	</div>

{% endblock %}

{% block content %}
    {% import '@core/form.twig' as form %}
    {% import '@gallerygroups/_admin-ui.twig' as groupsUi %}
    {% import _self as f %}

    <div class="settings-wrap" data-leave-confirm="{{ translate('Your changes not saved. You really want to leave without saving?') }}" data-gallery-id="{{ gallery.id }}" data-collapsed-sections="{{ (settings.ui.collapsedSections|default({}))|json_encode|e }}">
        {{ form.open('post', environment.generateUrl('galleries', 'saveSettings', { 'gallery_id': gallery.id, '_wpnonce': _wpnonce }), { 'id': 'form-settings', 'class': 'form-gall-settings', 'data-gg-license-inactive': licenseActive ? '0' : '1', 'data-gg-has-pro-settings': hasProConfiguredSettings ? '1' : '0' }) }}
        {# Set to '1' by the pro-wipe-warning confirm dialog in settings.js right
           before it resubmits the form - saveSettingsAction reads this as the
           user's explicit go-ahead to overwrite Pro options while unlicensed. #}
        <input id="ggConfirmProWipe" name="gg_confirm_pro_wipe" type="hidden" value="0"/>
        <input id="currentPresetTitle" name="title" type="hidden" value="{{ settings.title|default('') }}"/>
        <input name="previewImage" type="hidden" value="{{ gallery.settings.previewImage }}"/>
        <input name="sort[sortto]" type="hidden" value="{{ settings.sort.sortto }}"/>
        <input name="sort[sortby]" type="hidden" value="{{ settings.sort.sortby }}"/>
        {# Not a real form field - the chevron collapse/expand state is normally
           autosaved straight to the DB via the saveUiState AJAX action, but the
           big Save button here does a full-form POST that rebuilds the whole
           settings blob from just the submitted fields (saveSettingsAction),
           so without this hidden field that autosaved state would get silently
           wiped on every regular Save. Kept in sync by initCollapsibleSections;
           decoded server-side the same way attributes[order]/[enable] already are. #}
        <input name="ui[collapsedSections]" id="uiCollapsedSectionsInput" type="hidden" value="{{ (settings.ui.collapsedSections|default({}))|json_encode|e }}"/>
		{{ form.hidden('plugins[membership][enable]', settings.plugins.membership.enable, {'id':'hiddenInpMembershipEnableVal'}) }}
		{% block proHiddenSettings %}{% endblock %}

        <div data-tab="settings">

            {% block area %}
                <table class="form-table" name="area" id="gg-anl-main">
                    <thead>
						{% block galleryTypeSelectorItems %}
							{% set galleryTypeObj = [
								{'value':'0', 'title':'Fixed'},
								{'value':'1', 'title':'Vertical'},
								{'value':'2', 'title':'Horizontal'},
								{'value':'3', 'title':'Fixed Columns'},
								{'value':'4', 'title':'Mosaic(' ~ translate('Available in Pro') ~ ')', 'disabled':1},
							] %}

							{{ form.row(translate('Gallery Type'),
								form.selectWithElem(
									'area[grid]',
									galleryTypeObj,
									settings.area.grid,
									{ 'style': 'width: auto;' }
								),
								'grid-type', 'gallery-types', 'columns'
							)}}
						{% endblock %}

                        <tr id="generalColumnsRow" hidden>
                            <th scope="row">
                                <label style="margin: 0 !important;">
                                    {{ translate('Number of Columns') }}
        							{{ form.show_tooltip('columns') }}
        							<br />
        							<label><a href="https://supsystic.com/fixed-columns-gallery-example/" style="color: #0074a2; font-size: 10px; text-decoration: none;">More Info</a> </label>
                                </label>
                            </th>
                            <td>
                                <input type="number" name="general[columns][number]" value="{{ settings.general.columns.number|default(3) }}">
                            </td>
                        </tr>

                        {{ form.row(translate('Responsive columns'),
                        form.input('number', 'general[responsiveColumns][desktop][width]',settings.general.responsiveColumns.desktop.width|default(1200), { 'style': { 'width': '100px;' } }) ~ form.span('', 'px') ~
                        form.input('number', 'general[responsiveColumns][desktop][columns]', settings.general.responsiveColumns.desktop.columns|default(settings.general.columns.number|default(3)), { 'style': { 'width': '70px;' } }) ~ form.span('', 'columns') ~
                        '<br>' ~
                        form.input('number', 'general[responsiveColumns][tablet][width]', settings.general.responsiveColumns.tablet.width|default(768), { 'style': { 'width': '100px;' } }) ~ form.span('', 'px') ~
                        form.input('number', 'general[responsiveColumns][tablet][columns]', settings.general.responsiveColumns.tablet.columns|default(settings.general.columns.number|default(3)), { 'style': { 'width': '70px;' } }) ~ form.span('', 'columns') ~
                        '<br>' ~
                        form.input('number', 'general[responsiveColumns][mobile][width]',
                        settings.general.responsiveColumns.mobile.width|default(320), { 'style': { 'width': '100px;' } }) ~ form.span('', 'px') ~
                        form.input('number', 'general[responsiveColumns][mobile][columns]', settings.general.responsiveColumns.mobile.columns|default(settings.general.columns.number|default(3)), { 'style': { 'width': '70px;' } }) ~ form.span('', 'columns'), 'responsive-columns') }}

                        {#{{ form.row(environment.translate('Position'),
                        form.select('area[position]', ['Center', 'Left', 'Right'], settings.area.position, { 'style': 'width: 300px;' }), 'grid-type') }}#}

    					{{ form.row(translate('Gallery Name:'),
                        form.input('text', 'title', gallery.title, { 'style': { 'width': '232px;' } })
                        , 'title', null, 'gallery-name-row') }}

                        {% if galleryGroups is defined and galleryGroups is not empty %}
                            {{ form.row(translate('Gallery Groups'),
                                groupsUi.ajax_select(
                                    'gg-gallery-groups-select',
                                    'gallery_group_ids[]',
                                    'gallery_group',
                                    selectedGalleryGroupChoices|default([]),
                                    {
                                        'action': 'sg_gallerygroups_search_groups',
                                        'nonce': _wpnonce,
                                        'multiple': true,
                                        'activeOnly': 1,
                                        'placeholder': translate('Search gallery groups...'),
                                        'emptyText': translate('No groups found')
                                    }
                                ),
                                'gallery-groups', null, 'gallery-groups-row') }}
                        {% endif %}

						{{ form.row(environment.translate('Gallery alignment'),
							form.select('area[position]', ['Left', 'Center', 'Right'], settings.area.position|default(1), { 'style': 'width: 100px;' }), 'gallery-align') }}


						{{ form.row(translate('Distance between images'),
                        form.input('number', 'area[distance]', settings.area.distance, { 'style': { 'width': '140px;' } })
                        ~ form.span('', 'pixels'), 'distance') }}

                        {{ form.row(translate('Gallery width'),
                        form.input('number', 'area[width]', settings.area.width, { 'style': { 'width': '140px' } })
                        ~ form.select('area[width_unit]', ['pixels', 'percents'], settings.area.width_unit, { 'style': 'margin-top: -2px; height: 27px;' }), 'area-width') }}

                        {# Setting gallery to full width of window  #}
                        {{ form.row(translate('Full screen width'),
                            form.checkbox(
                            'fullscreen',
                            '1',
                            settings.fullscreen ? {'checked':'checked'} : {}
                            ),
                            'full-screen-width')
                        }}

                        {{ form.row(translate('Gallery padding'),
                        form.input('number', 'area[padding]', settings.area.padding|default(0), { 'style': { 'width': '140px' } }) ~ form.span('', 'pixels'), 'area-padding') }}

                        {#
                            {{ form.row(environment.translate('Gallery height'),
                            form.input('number', 'area[height]', settings.area.height, { 'style': { 'width': '205px'} })
                            ~ form.select('', ['pixels', 'percents'], null, { 'disabled': 'disabled', 'style': 'margin-top: -2px; height: 27px' }), 'area-height') }}
                        #}

                        {{ form.row(translate('Image width'),
                        form.input('number', 'area[photo_width]', settings.area.photo_width, { 'style': { 'width': '140px'} })
                        ~ form.select('area[photo_width_unit]', ['pixels', 'percents'], settings.area.photo_width_unit, { 'style': 'margin-top: -2px; height: 27px; width: 85px;' }), 'photo-width') }}


                        {{ form.row(translate('Image height'),
                        form.input('number', 'area[photo_height]', settings.area.photo_height, { 'style': { 'width': '140px'} })
                        ~ form.select('area[photo_height_unit]', ['pixels'], settings.area.photo_height_unit, { 'style': 'margin-top: -2px; height: 27px; width: 85px;' }), 'photo-height') }}

                        {{ form.row(translate('Image radius'),
                        form.input('number', 'thumbnail[border][radius]', settings.thumbnail.border.radius, { 'style': { 'width': '140px'} })
