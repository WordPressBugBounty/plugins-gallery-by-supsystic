                            <img src="{{ SGG_PLUGIN_URL }}/app/assets/img/social_icons_2.png" style="max-width:99%;display:block;margin-bottom:8px;" />
                            <img src="{{ SGG_PLUGIN_URL }}/app/assets/img/social_icons_3.png" style="max-width:99%;display:block;margin-bottom:8px;" />
