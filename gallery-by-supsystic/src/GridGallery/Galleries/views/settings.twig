                    {% if (environment.isPro() == false) %}
                        {% set socialSharingProDescription %}
                            <p>{{ translate('Add social share buttons for all popular social networks - Facebook, X, Telegram, WhatsApp, Viber, LinkedIn, Pinterest, Tumblr, Print and Bookmark. Fully configurable from the gallery settings, with a range of visual styles - colors, shapes and sizes - to match your site, for the gallery, images and popup.') }}</p>
