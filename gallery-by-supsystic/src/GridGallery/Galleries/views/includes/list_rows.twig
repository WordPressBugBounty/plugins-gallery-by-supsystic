{% for gallery in galleries %}
    <tr id="gallery-{{ gallery.id }}" data-gallery-id="{{ gallery.id }}">
        <td class="gg-col-check">
            <input type="checkbox" class="gg-row-checkbox" id="check_{{ gallery.id }}" data-gallery-id="{{ gallery.id }}" name="check_{{ gallery.id }}">
        </td>
        <td class="gg-col-id">{{ gallery.id }}</td>
        <td class="gg-col-thumb">
            {% set cover = '' %}
            {% if gallery.attachment_id == 0 and gallery.link_default|length > 1 %}
                {% set cover = gallery.link_default %}
            {% elseif gallery.attachment_id > 0 %}
                {% set cover = get_attachment(gallery.attachment_id, '150', '150', 'true') %}
            {% endif %}

            {% if cover|length < 1 and gallery.settings.posts.postCover|length > 1 %}
                {% set cover = gallery.settings.posts.postCover %}
            {% endif %}
            <div class="gg-thumb-wrap{{ cover|length < 1 ? ' gg-thumb-empty' : '' }}">
                {% if cover|length > 0 %}
                    <img src="{{ cover }}" alt="{{ gallery.title }}">
                {% else %}
                    <img src="{{ environment.getModule('overview').getLocationUrl() }}/assets/img/plugin-icon.png" alt="{{ gallery.title }}">
                {% endif %}
            </div>
        </td>
        <td class="gg-col-title">
            <a href="{{ environment.generateUrl('galleries', 'settings', { 'gallery_id': gallery.id }) }}" data-toggle="tooltip" title="{{ environment.translate('Edit gallery "%s"') | format(gallery.title) }}">
                {{ gallery.title|title }}
            </a>
            <i class="fa fa-fw fa-pencil"></i>
        </td>
        <td class="gg-col-type">
            <span class="gg-type-badge">{{ gallery.typeLabel }}</span>
        </td>
        <td class="gg-col-group">
            {% if gallery.gallery_group is defined and gallery.gallery_group is not empty %}
                {{ gallery.gallery_group }}
            {% else %}
                &mdash;
            {% endif %}
        </td>
        <td class="gg-col-count">{{ gallery.total|default(0) }}</td>
        <td class="gg-col-date">{{ gallery.createdFormatted }}</td>
        <td class="gg-col-date">{{ gallery.modifiedFormatted }}</td>
        <td class="gg-col-code">
            <input type="text" id="shortcode-{{ gallery.id }}" readonly class="ggCopyTextCode shortcode" value="[supsystic-gallery id='{{ gallery.id }}']">
            <input type="text" id="phpcode-{{ gallery.id }}" readonly class="ggCopyTextCode phpcode"
                   value="{{ '<?php echo do_shortcode(\'[supsystic-gallery id=' ~ gallery.id ~ ']\') ?>' }}">
        </td>
        <td class="gg-col-actions">
            {# Like the tables list of Data Tables: one Edit button, the other actions as icons with a tooltip #}
            <div class="sgg-row-actions">
                <a href="{{ environment.generateUrl('galleries', 'settings', { 'gallery_id': gallery.id }) }}"
                   class="button background sggActionButtons sgg-act-edit" title="{{ translate('Settings') }}">
                    <i class="fa fa-pencil" aria-hidden="true"></i>
                    {{ translate('Edit') }}
                </a>
                <a href="{{ environment.generateUrl('galleries', 'view', { 'gallery_id': gallery.id }) }}"
                   class="button background sggActionButtons sgg-act-icon" title="{{ translate('Images list') }}">
                    <i class="fa fa-th" aria-hidden="true"></i>
                    <span class="screen-reader-text">{{ translate('Images list') }}</span>
                </a>
                <button class="button button-primary gallery import-to-gallery sggActionButtons sgg-act-icon" data-folder-id="0"
                        data-gallery-id="{{ gallery.id }}" title="{{ translate('Add Images') }}">
                    <i class="fa fa-camera" aria-hidden="true"></i>
                    <span class="screen-reader-text">{{ translate('Add Images') }}</span>
                </button>
                <a href="{{ environment.generateUrl('galleries', 'preview', { 'gallery_id': gallery.id, '_wpnonce': _wpnonce }) }}"
                   class="button background sggActionButtons sgg-act-icon" title="{{ translate('Preview') }}">
                    <i class="fa fa-eye" aria-hidden="true"></i>
                    <span class="screen-reader-text">{{ translate('Preview') }}</span>
                </a>
                <button type="button" class="button button-primary sggActionButtons gg-clone-gallery sgg-act-icon" data-gallery-id="{{ gallery.id }}" title="{{ translate('Clone this gallery') }}">
                    <i class="fa fa-clone" aria-hidden="true"></i>
                    <span class="screen-reader-text">{{ translate('Clone') }}</span>
                </button>
                <a id="delete-gallery" data-confirm="{{ translate('Are you sure you want to delete this gallery?') }}" class="button button-primary sggActionButtons sgg-act-icon sgg-act-danger" title="{{ translate('Delete gallery') }}"
                   href="{{ environment.generateUrl('galleries', 'delete', { 'gallery_id': gallery.id, '_wpnonce': _wpnonce }) }}">
                    <i class="fa fa-trash" aria-hidden="true"></i>
                    <span class="screen-reader-text">{{ translate('Delete gallery') }}</span>
                </a>
            </div>
        </td>
    </tr>
{% else %}
    <tr class="gg-empty-row">
        <td colspan="11">
            <i class="fa fa-picture-o" aria-hidden="true"></i>
            <strong>{{ translate('No galleries found') }}</strong>
            <span>{{ translate('Try another search or create a new gallery.') }}</span>
        </td>
    </tr>
{% endfor %}
