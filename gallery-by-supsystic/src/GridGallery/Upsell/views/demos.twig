{# The small picture of each PRO feature window (windows.twig): a looped mock of the feature on a page, drawn with
   HTML and CSS (upsell.css), no image files. Photos are painted landscapes (.sgg-up-ph, variants a to f). With reduced
   motion the pictures stand still on their most telling frame. #}
{% set t = environment %}
{% if key == 'effects' %}
    <div class="sgg-up-cube-scene">
        <div class="sgg-up-cube">
            <i class="sgg-up-ph is-a"></i><i class="sgg-up-ph is-b"></i><i class="sgg-up-ph is-c"></i><i class="sgg-up-ph is-d"></i>
        </div>
    </div>
    <div class="sgg-up-chips is-pick"><span>Coverflow</span><span class="is-on">Cube</span><span>Flip</span><span>Cards</span><span>Creative</span></div>
{% elseif key == 'posts' %}
    <div class="sgg-up-reel">
        <div class="sgg-up-reel-track">
            {% for post in [['a', t.translate('How we shot the northern lights')], ['b', t.translate('Ten lakes worth the hike')], ['c', t.translate('Packing light for a week')], ['a', t.translate('How we shot the northern lights')], ['b', t.translate('Ten lakes worth the hike')], ['c', t.translate('Packing light for a week')]] %}
                <span class="sgg-up-post"><i class="sgg-up-ph is-{{ post[0] }}"></i><em>11.11.2026</em><strong>{{ post[1] }}</strong><u>{{ t.translate('Read more') }}</u></span>
            {% endfor %}
        </div>
    </div>
{% elseif key == 'productFilters' %}
    <div class="sgg-up-rules">
        <span class="is-in"><i class="fa fa-check"></i>{{ t.translate('Only') ~ ': ' ~ t.translate('Shoes') ~ ', ' ~ t.translate('Bags') }}</span>
        <span class="is-out"><i class="fa fa-ban"></i>{{ t.translate('Leave out') ~ ': ' ~ t.translate('Sale') }}</span>
    </div>
    <div class="sgg-up-shop">
        {% for card in ['a', 'b', 'x', 'c', 'x', 'd'] %}
            <span class="sgg-up-product{% if card == 'x' %} is-dropped{% endif %}"><i class="sgg-up-ph is-{{ card == 'x' ? 'e' : card }}"></i><b></b><em>$49</em></span>
        {% endfor %}
    </div>
{% elseif key == 'compare' %}
    <div class="sgg-up-cmp">
        <i class="sgg-up-ph is-d"></i>
        <i class="sgg-up-ph is-d sgg-up-cmp-before"></i>
        <span class="sgg-up-cmp-line"><b><i class="fa fa-arrows-h"></i></b></span>
        <em class="is-left">{{ t.translate('Before') }}</em>
        <em class="is-right">{{ t.translate('After') }}</em>
    </div>
{% elseif key == 'layers' or key == 'animations' %}
    <div class="sgg-up-slide{% if key == 'animations' %} is-animated{% else %} is-editing{% endif %}">
        <i class="sgg-up-ph is-b"></i>
        <span class="sgg-up-l sgg-up-l-badge">{{ t.translate('New') }}</span>
        <span class="sgg-up-l sgg-up-l-title">{{ t.translate('Summer collection') }}</span>
        <span class="sgg-up-l sgg-up-l-text">{{ t.translate('Light fabrics, bright colors') }}</span>
        <span class="sgg-up-l sgg-up-l-button">{{ t.translate('Shop now') }}</span>
        {% if key == 'layers' %}
            <i class="fa fa-mouse-pointer sgg-up-cursor"></i>
            <span class="sgg-up-devices"><i class="fa fa-desktop"></i><i class="fa fa-tablet"></i><i class="fa fa-mobile"></i></span>
        {% endif %}
    </div>
{% elseif key == 'video' %}
    <div class="sgg-up-slide is-video">
        <i class="sgg-up-ph is-c"></i>
        <span class="sgg-up-play"><i class="fa fa-play"></i></span>
        <span class="sgg-up-progress"><i></i></span>
    </div>
    <div class="sgg-up-chips"><span>YouTube</span><span>Vimeo</span><span>MP4</span><span>WebM</span></div>
{% elseif key == 'styles' %}
    <div class="sgg-up-restyle">
        <span class="sgg-up-restyle-row">
            <i class="sgg-up-ph is-a"></i><i class="sgg-up-ph is-c"></i><i class="sgg-up-ph is-d"></i>
            <b class="is-prev"></b><b class="is-next"></b>
        </span>
        <span class="sgg-up-restyle-dots"><u></u><u class="is-on"></u><u></u><u></u></span>
    </div>
    <div class="sgg-up-chips is-cycle is-5"><span>Studio</span><span>Nature</span><span>Ocean</span><span>Night</span><span>Pop</span></div>
{% elseif key == 'mosaic' %}
    <div class="sgg-up-mosaic">
        {% for tile in ['a', 'b', 'c', 'd', 'e', 'f', 'b'] %}<i class="sgg-up-ph is-{{ tile }}"></i>{% endfor %}
    </div>
{% elseif key == 'lightbox' %}
    <div class="sgg-up-lb">
        <span class="sgg-up-lb-page">{% for tile in ['a', 'b', 'c', 'd', 'e', 'f'] %}<i class="sgg-up-ph is-{{ tile }}"></i>{% endfor %}</span>
        <span class="sgg-up-lb-box">
            <span class="sgg-up-lb-top"><em>3 / 12</em><i class="fa fa-play"></i><i class="fa fa-share-alt"></i><i class="fa fa-download"></i><i class="fa fa-times"></i></span>
            <span class="sgg-up-lb-photo">{% for tile in ['a', 'b', 'c', 'd', 'e'] %}<i class="sgg-up-ph is-{{ tile }}"></i>{% endfor %}</span>
            <span class="sgg-up-lb-strip">{% for tile in ['a', 'b', 'c', 'd', 'e'] %}<i class="sgg-up-ph is-{{ tile }}"></i>{% endfor %}<b></b></span>
            <span class="sgg-up-lb-bar"></span>
        </span>
    </div>
{% elseif key == 'useCats' %}
    <div class="sgg-up-tabs is-cycle is-4"><span>{{ t.translate('All') }}</span><span>{{ t.translate('Nature') }}</span><span>{{ t.translate('City') }}</span><span>{{ t.translate('Sea') }}</span></div>
    <div class="sgg-up-grid is-cats">
        {% for tile in [['d', 'n'], ['f', 'k'], ['c', 's'], ['a', 'n'], ['e', 'k'], ['c', 's']] %}<i class="sgg-up-ph is-{{ tile[0] }} is-cat-{{ tile[1] }}"></i>{% endfor %}
    </div>
{% elseif key == 'usePages' %}
    <div class="sgg-up-grid is-pages">
        {% for tile in ['a', 'b', 'c', 'd', 'e', 'f'] %}<i class="sgg-up-ph is-{{ tile }}"></i>{% endfor %}
    </div>
    <div class="sgg-up-tabs is-pager is-cycle is-3"><span>1</span><span>2</span><span>3</span></div>
{% elseif key == 'show-more' %}
    <div class="sgg-up-more-grid">
        <span class="sgg-up-grid">{% for tile in ['a', 'b', 'c', 'd', 'e', 'f'] %}<i class="sgg-up-ph is-{{ tile }}"></i>{% endfor %}</span>
        <span class="sgg-up-grid is-extra">{% for tile in ['c', 'a', 'e'] %}<i class="sgg-up-ph is-{{ tile }}"></i>{% endfor %}</span>
    </div>
    <span class="sgg-up-button">{{ t.translate('Load more') }}</span>
{% elseif key == 'sgg-posts-layout-enable' %}
    <div class="sgg-up-grid is-feed">
        {% for post in [['b', t.translate('Ten lakes worth the hike')], ['d', t.translate('A morning in the forest')], ['a', t.translate('Packing light for a week')], ['c', t.translate('How we shot the northern lights')]] %}
            <span class="sgg-up-feed"><i class="sgg-up-ph is-{{ post[0] }}"></i><span><em>11.11.2026</em><strong>{{ post[1] }}</strong></span></span>
        {% endfor %}
    </div>
{% elseif key == 'showWatermRow' %}
    <div class="sgg-up-photo-frame">
        <i class="sgg-up-ph is-b"></i>
        <span class="sgg-up-mark-tile">{% for i in 1..6 %}<em>© Your Studio</em>{% endfor %}</span>
        <span class="sgg-up-mark"><i class="fa fa-camera"></i>{{ ' ' }}Your Studio</span>
    </div>
{% elseif key == 'social-sharing' %}
    <div class="sgg-up-photo-frame">
        <i class="sgg-up-ph is-c"></i>
        <span class="sgg-up-share">
            <b style="background:#1877f2"><i class="fa-brands fa-facebook-f"></i></b>
            <b style="background:#0f1419"><i class="fa-brands fa-x-twitter"></i></b>
            <b style="background:#e60023"><i class="fa-brands fa-pinterest-p"></i></b>
            <b style="background:#26a5e4"><i class="fa-brands fa-telegram"></i></b>
            <b style="background:#25d366"><i class="fa-brands fa-whatsapp"></i></b>
        </span>
    </div>
{% elseif key == 'ggExifDataTable' %}
    <div class="sgg-up-photo-frame">
        <i class="sgg-up-ph is-e"></i>
        <span class="sgg-up-exif">
            <span><i class="fa fa-camera-retro"></i>{{ ' ' ~ t.translate('Camera') }}<b>24 MP</b></span>
            <span><i class="fa fa-circle"></i>{{ ' ' ~ t.translate('Lens') }}<b>35 mm f/1.8</b></span>
            <span><i class="fa fa-clock"></i>{{ ' ' ~ t.translate('Exposure') }}<b>1/250 s</b></span>
            <span><i class="fa fa-adjust"></i>{{ ' ' }}ISO<b>200</b></span>
        </span>
    </div>
{% elseif key == 'useCaptionBuilder' %}
    <div class="sgg-up-photo-frame is-square">
        <i class="sgg-up-ph is-f"></i>
        <span class="sgg-up-builder">
            <strong>{{ t.translate('Desert road') }}</strong>
            <em>{{ t.translate('Shot at sunset, July') }}</em>
            <span><i class="fa fa-search-plus"></i><i class="fa fa-link"></i><i class="fa fa-heart"></i></span>
        </span>
    </div>
{% elseif key == 'photo-icon' %}
    <div class="sgg-up-grid is-three is-icons">
        {% for tile in ['a', 'c', 'd'] %}<span class="sgg-up-tile"><i class="sgg-up-ph is-{{ tile }}"></i><span class="sgg-up-tile-icons"><b><i class="fa fa-search-plus"></i></b><b><i class="fa fa-link"></i></b></span></span>{% endfor %}
    </div>
{% elseif key == 'sggLazyLoadEnableRow' %}
    <div class="sgg-up-lazy">
        <span class="sgg-up-lazy-page">
            {% for tile in ['a', 'b', 'c', 'd', 'e', 'f', 'a', 'c', 'b'] %}<span class="sgg-up-lazy-tile"><i class="sgg-up-ph is-{{ tile }}"></i></span>{% endfor %}
        </span>
        <span class="sgg-up-lazy-scroll"><i></i></span>
    </div>
{% elseif key == 'useCdnRow' %}
    <svg class="sgg-up-cdn" viewBox="0 0 340 200">
        <circle cx="170" cy="100" r="86" class="sgg-up-cdn-globe"></circle>
        <ellipse cx="170" cy="100" rx="38" ry="86" class="sgg-up-cdn-meridian"></ellipse>
        <ellipse cx="170" cy="100" rx="86" ry="32" class="sgg-up-cdn-meridian"></ellipse>
        {% for node in [[46, 44, 'New York', 'end'], [64, 158, 'São Paulo', 'end'], [232, 28, 'Frankfurt', 'start'], [298, 96, 'Tokyo', 'start'], [258, 172, 'Sydney', 'start']] %}
            {% set route = 'M170 100 L' ~ node[0] ~ ' ' ~ node[1] %}
            <path d="{{ route }}" class="sgg-up-cdn-route"></path>
            <circle r="3.5" class="sgg-up-cdn-packet"><animateMotion dur="2.4s" begin="{{ loop.index0 * -0.45 }}s" repeatCount="indefinite" path="{{ route }}"></animateMotion></circle>
            <circle cx="{{ node[0] }}" cy="{{ node[1] }}" r="5.5" class="sgg-up-cdn-node" style="animation-delay: {{ loop.index0 * -0.45 }}s"></circle>
            <text x="{{ node[3] == 'end' ? node[0] - 9 : node[0] + 9 }}" y="{{ node[1] + 3.5 }}" text-anchor="{{ node[3] }}" class="sgg-up-cdn-label">{{ node[2] }}</text>
        {% endfor %}
        <rect x="151" y="81" width="38" height="38" rx="11" class="sgg-up-cdn-core"></rect>
        <path d="M159 110 L166 101 L171 106 L176 98 L182 110 Z" class="sgg-up-cdn-pic"></path>
        <circle cx="178" cy="92" r="2.6" class="sgg-up-cdn-pic"></circle>
    </svg>
{% elseif key == 'useOptimizationRow' %}
    <div class="sgg-up-opt">
        <span class="sgg-up-file"><i class="sgg-up-ph is-a"></i><strong>photo.jpg</strong><em>4.8 MB</em></span>
        <span class="sgg-up-opt-arrow"><i class="fa fa-long-arrow-right"></i><b><i></i></b></span>
        <span class="sgg-up-file is-light"><i class="sgg-up-ph is-a"></i><strong>photo.webp</strong><em>412 KB</em><u>−91%</u></span>
    </div>
    <div class="sgg-up-chips"><span>TinyPNG</span><span>WebP</span><span>AVIF</span><span>{{ t.translate('Max size') }}</span></div>
{% elseif key == 'custom_buttons' %}
    <div class="sgg-up-btns">
        <span class="sgg-up-btn-row"><b class="is-on">{{ t.translate('All') }}</b><b>{{ t.translate('Nature') }}</b><b>{{ t.translate('City') }}</b></span>
        <span class="sgg-up-btn-row"><b>1</b><b class="is-on">2</b><b>3</b></span>
        <span class="sgg-up-btn-row"><b class="is-on is-wide">{{ t.translate('Load more') }}</b></span>
    </div>
    <div class="sgg-up-chips is-cycle is-4"><span>Teal pill</span><span>Ink</span><span>Outline</span><span>Sunset</span></div>
{% elseif key == 'useCaptions' %}
    <div class="sgg-up-grid is-three is-captions">
        {% for tile in [['b', t.translate('Lake view')], ['d', t.translate('Pine trail')], ['f', t.translate('Dunes')]] %}<span class="sgg-up-tile"><i class="sgg-up-ph is-{{ tile[0] }}"></i><span class="sgg-up-tile-caption"><strong>{{ tile[1] }}</strong><em>{{ t.translate('Summer trip') }}</em></span></span>{% endfor %}
    </div>
{% elseif key == 'custom_attributes' %}
    <div class="sgg-up-attr-bar">
        <span class="sgg-up-select">{{ t.translate('Size') }}: L<i class="fa fa-angle-down"></i></span>
        <span class="sgg-up-search"><i class="fa fa-search"></i><span class="sgg-up-typed">blue</span></span>
    </div>
    <div class="sgg-up-grid is-attrs">
        {% for tile in [['c', '$120', 'L', ''], ['e', '$80', 'S', ' is-dropped'], ['c', '$95', 'L', ''], ['b', '$60', 'M', ' is-dropped']] %}
            <span class="sgg-up-tile{{ tile[3] }}"><i class="sgg-up-ph is-{{ tile[0] }}"></i><span class="sgg-up-tags"><b>{{ tile[1] }}</b><b>{{ tile[2] }}</b></span></span>
        {% endfor %}
    </div>
{% elseif key == 'additinalCaptionSettings' %}
    <div class="sgg-up-grid is-four is-fx">
        {% for tile in [['a', t.translate('Zoom')], ['c', t.translate('Turn')], ['d', t.translate('Color')], ['f', t.translate('Lift')]] %}
            <span class="sgg-up-fx"><span class="sgg-up-tile"><i class="sgg-up-ph is-{{ tile[0] }}"></i></span><em>{{ tile[1] }}</em></span>
        {% endfor %}
    </div>
{% else %}
    <img class="sgg-up-shot" data-sgg-up-shot alt="" hidden>
    <span class="sgg-up-icon"><i class="{{ 'fa ' ~ f.icon }}"></i></span>
{% endif %}
