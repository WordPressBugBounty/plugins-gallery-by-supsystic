<dialog class="sgg-up" data-sgg-up aria-labelledby="sgg-up-title">
    <button type="button" class="sgg-up-close" data-sgg-up-close aria-label="{{ environment.translate('Close')|e('html_attr') }}">&times;</button>
    <div class="sgg-up-body" data-sgg-up-body></div>
</dialog>
{% for key, f in features %}
    <template id="sgg-up-{{ key }}">
        <div class="sgg-up-hero">
            <span class="sgg-up-eyebrow"><i class="fa fa-diamond" aria-hidden="true"></i>{{ environment.translate('PRO feature') }}</span>
            <div class="sgg-up-head">
                <div>
                    <h2 id="sgg-up-title">{{ f.title }}</h2>
                    <p>{{ f.text }}</p>
                </div>
                <a class="sgg-up-cta" href="{{ environment.getProUrl('utm_source=plugin&utm_medium=' ~ f.medium ~ '&utm_campaign=gallery')|e('html_attr') }}" target="_blank" rel="noopener">{{ environment.translate('Get PRO') }}<i class="fa fa-arrow-right" aria-hidden="true"></i></a>
            </div>
        </div>
        <div class="sgg-up-main">
            <div class="sgg-up-demo" aria-hidden="true">
                <div class="sgg-up-demo-bar"><i></i><i></i><i></i><span>{{ environment.translate('On your page') }}</span></div>
                <div class="sgg-up-stage sgg-up-stage-{{ key }}">
                    {% include '@upsell/demos.twig' %}
                </div>
            </div>
            <div class="sgg-up-info">
                <h3>{{ environment.translate('What you get') }}</h3>
                <ul>
                    {% for point in f.points %}<li>{{ point }}</li>{% endfor %}
                </ul>
                <h3>{{ environment.translate('Great for') }}</h3>
                <div class="sgg-up-uses">
                    {% for use in f.uses %}<span>{{ use }}</span>{% endfor %}
                </div>
            </div>
        </div>
        <div class="sgg-up-more">
            <span class="sgg-up-more-label">{{ environment.translate('Also in PRO') }}</span>
            {% for otherKey, other in features %}
                {% if otherKey != key and other.group == f.group %}
                    <button type="button" data-sgg-upsell="{{ otherKey }}"><i class="{{ 'fa ' ~ other.icon }}" aria-hidden="true"></i>{{ ' ' ~ other.chip }}</button>
                {% endif %}
            {% endfor %}
        </div>
    </template>
{% endfor %}
