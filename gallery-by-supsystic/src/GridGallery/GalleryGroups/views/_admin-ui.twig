{% macro help(text) %}
    <i class="fa fa-question supsystic-tooltip" title="{{ text|e }}"></i>
{% endmacro %}

{% macro label(for, text, helpText) %}
    <label for="{{ for }}">{{ text }}</label>
    {% if helpText %}
        {{ _self.help(helpText) }}
    {% endif %}
{% endmacro %}

{% macro ajax_select(id, name, entityType, selected, options) %}
    {% set options = options|default({}) %}
    <div id="{{ id }}"
         class="gg-ajax-select"
         data-action="{{ options.action|default('sg_gallerygroups_search_galleries') }}"
         data-ajax-url="{{ options.ajaxUrl|default('') }}"
         data-nonce="{{ options.nonce|default('') }}"
         data-name="{{ name }}"
         data-multiple-name="{{ options.multipleName|default(name) }}"
         data-entity-type="{{ entityType }}"
         data-entity-type-source="{{ options.entityTypeSource|default('') }}"
         data-multiple="{{ options.multiple is defined and options.multiple == false ? '0' : '1' }}"
         data-active-only="{{ options.activeOnly|default(0) }}"
         data-empty-text="{{ options.emptyText|default('No results') }}">
        <div class="gg-ajax-selected" data-role="chips"></div>
        <div data-role="hidden"></div>
        {% for item in selected|default([]) %}
            <span data-selected-id="{{ item.id }}" data-selected-text="{{ item.text|e }}"></span>
        {% endfor %}
        <input type="search" class="gg-ajax-search regular-text" data-role="search" placeholder="{{ options.placeholder|default('Search...') }}">
        <div class="gg-ajax-results" data-role="results"></div>
    </div>
{% endmacro %}
